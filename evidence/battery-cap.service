[Unit]
Description=Battery charge cap - re-apply /etc/battery-cap (EC RAM clears on power loss)

[Service]
Type=oneshot
RemainAfterExit=yes
# The EC is not guaranteed ready the instant boot starts.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/local/bin/batterycctl apply

[Install]
WantedBy=multi-user.target

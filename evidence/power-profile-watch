#!/usr/bin/env python3
"""Re-apply the power profile the instant the platform profile is written.

Why this exists: writing `/sys/class/platform-profile/.../profile` makes the HP EC
re-apply its own SMU limits, silently clobbering whatever the OS set. Measured on
this machine:

    write 35/42/35
    echo balanced > platform_profile
    -> limits are 54/65/54 again, within a second

`power-profile.timer` re-applies every 5 minutes, so the machine can sit at the
EC's limits for almost that long. This closes the window to the time it takes to
run the apply, by watching the file instead of polling.

inotify does work on this sysfs attribute (verified: MODIFY then CLOSE_WRITE),
which is what makes this possible -- polling the limits would be both slower and
heavier.

Nothing is written here. This only *notices*; the actual apply is delegated to
`systemctl start power-profile.service`, so there is one implementation of the
profile and this cannot drift from it.
"""

from __future__ import annotations

import ctypes
import ctypes.util
import os
import select
import signal
import struct
import subprocess
import sys
import time

PROFILE = "/sys/class/platform-profile/platform-profile-0/profile"
SERVICE = "power-profile.service"

IN_MODIFY = 0x2
IN_CLOSE_WRITE = 0x8
IN_NONBLOCK = 0o4000

# A single write produces MODIFY then CLOSE_WRITE; coalesce anything within this
# window into one apply.
DEBOUNCE = 0.4

_running = True


def _stop(signum, frame):
    global _running
    _running = False


def apply_profile(reason: str) -> None:
    start = time.monotonic()
    r = subprocess.run(["systemctl", "start", SERVICE],
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    dt = time.monotonic() - start
    if r.returncode == 0:
        print(f"re-applied after {reason} in {dt:.2f}s", flush=True)
    else:
        print(f"FAILED to re-apply after {reason}: {r.stderr.decode().strip()}",
              flush=True)


def main() -> None:
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    fd = libc.inotify_init1(IN_NONBLOCK)
    if fd < 0:
        sys.exit("inotify_init1 failed")

    if libc.inotify_add_watch(fd, PROFILE.encode(), IN_MODIFY | IN_CLOSE_WRITE) < 0:
        sys.exit(f"cannot watch {PROFILE} (errno {ctypes.get_errno()})")

    print(f"watching {PROFILE}", flush=True)

    while _running:
        r, _, _ = select.select([fd], [], [], 1.0)
        if not r:
            continue

        # drain, and note the value that was written
        value = None
        try:
            for _ in range(32):
                data = os.read(fd, 4096)
                if not data:
                    break
        except BlockingIOError:
            pass
        try:
            with open(PROFILE) as fh:
                value = fh.read().strip()
        except OSError:
            value = "?"

        # coalesce the MODIFY/CLOSE_WRITE pair and any repeat writes
        time.sleep(DEBOUNCE)
        try:
            while os.read(fd, 4096):
                pass
        except (BlockingIOError, OSError):
            pass

        apply_profile(f"platform_profile -> {value!r}")


if __name__ == "__main__":
    main()

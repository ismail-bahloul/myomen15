# Primary evidence kept local, not versioned.
#
# 133 JPEGs (~430 MB) photographing the SmokelessUMAF menus. Their content is
# transcribed in BIOS_arborescence_OMEN.md, which IS versioned, so git would
# carry 430 MB to deliver information that is already here in text.
#
# They also carry EXIF: capture date, phone model, and possibly GPS. No reason
# to publish that, and it is awkward to remove after the fact.
img_smokelessUMAF/

# Local dumps and scratch space
*.bin
*.aml
*.dsl
nvram-dump.txt

# Firmware analysis tooling + UEFIExtract output (regenerated from the .bin)
evidence/ifr-static/tools/
evidence/ifr-static/*.zip
evidence/ifr-static/*.dump/
evidence/ifr-static/088D1.bin.*
evidence/ifr-static/out/
evidence/ifr-static/bridge/out/

# Snapshot files produced by evidence/setupdiff.py and evidence/tpmstate.py.
# The ones worth keeping live in evidence/tpm-experiment/ and ARE versioned.
/setupdiff-*.json
/tpmstate-*.json

# MSI Afterburner's raw 1 Hz monitor dumps: 36 MB for one working session, and
# they accumulate every property whether or not it was asked for. The windows
# extracted from them ARE versioned, in evidence/dgpu-windows/windows.txt, and
# evidence/hml-analyze.py regenerates them from any .hml.
evidence/dgpu-windows/*.hml

# Python bytecode
__pycache__/
*.pyc

# Compiled CPU load harness -- built from load.c, whose source IS versioned.
/evidence/load
/evidence/wakelat

# Compiled AMD-TEE TA-signature test harness -- built from teeopen.c by run.sh.
/evidence/psp-tee-empirical/teeopen
